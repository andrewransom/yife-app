# Public Supabase client configuration. These values are client-visible.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Disabled by default. Set to true only for local wrapper/component inspection.
NUXT_PUBLIC_DEV_COMPONENT_WORKBENCH=false

# Optional local auth e2e settings.
E2E_AUTH_EMAIL=e2e@yife.local
E2E_AUTH_PASSWORD=password123
SUPABASE_SERVICE_ROLE_KEY=

# Never commit real secrets to local env files.
