{
  "name": "yife-app",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "nuxt dev app --host 127.0.0.1 --port 3055",
    "dev:agent": "nuxt dev app --host 127.0.0.1 --port 3056",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "db:types": "mkdir -p supabase/types && supabase gen types --local --lang=typescript --schema public > supabase/types/database.types.ts",
    "db:test": "bash scripts/supabase/run-sql-tests.sh",
    "e2e:seed-user": "node scripts/e2e/seed-local-auth-user.mjs",
    "test:e2e:auth": "pnpm e2e:seed-user && playwright test tests/e2e/auth-vertical.spec.ts",
    "build": "nuxt generate app",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --outDir app/.output/public",
    "typecheck": "nuxt typecheck app",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{css,ts,vue}\" \"tests/**/*.ts\" \"*.{json,mjs,ts}\"",
    "format:check": "prettier --check \"app/**/*.{css,ts,vue}\" \"tests/**/*.ts\" \"*.{json,mjs,ts}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e/smoke.spec.ts",
    "postinstall": "nuxt prepare app"
  },
  "dependencies": {
    "@nuxt/ui": "^4.8.2",
    "@nuxtjs/supabase": "^2.0.9",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/vue-query": "^5.101.0",
    "@tiptap/extension-link": "^3.26.1",
    "@tiptap/extension-placeholder": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "@tiptap/vue-3": "^3.26.1",
    "@vee-validate/zod": "^4.15.1",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.8",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.38",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.2",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "vue-demi"
    ]
  }
}
